{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-codeblock.local/schemas/script-interface-doc.v1.json",
  "title": "Flow Script Interface Document v1",
  "type": "object",
  "required": ["schema_version", "title", "summary", "endpoint", "request", "responses", "logic_description"],
  "properties": {
    "schema_version": {"const": "script-interface-doc.v1"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "endpoint": {
      "type": "object",
      "required": ["methods", "description"],
      "properties": {
        "methods": {"type": "array", "items": {"enum": ["GET", "POST"]}, "minItems": 1, "maxItems": 2, "uniqueItems": true},
        "path": {"type": "string", "pattern": "^/flow/codeblock/", "description": "相对路径；创建时可省略，更新时写 /flow/codeblock/<实际脚本ID>。完整地址另行拼接用户提供的域名。"},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["query", "headers"],
      "properties": {
        "query": {"$ref": "#/$defs/parameters"},
        "headers": {"$ref": "#/$defs/parameters"},
        "body": {"$ref": "#/$defs/body"}
      },
      "additionalProperties": false
    },
    "responses": {
      "type": "array",
      "items": {"$ref": "#/$defs/response"},
      "minItems": 1,
      "maxItems": 50
    },
    "logic_description": {"type": "string", "minLength": 20, "maxLength": 20000},
    "usage_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/usage"},
      "maxItems": 100
    }
  },
  "$defs": {
    "parameters": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["name", "type", "required", "description", "example"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "type": {"enum": ["string", "integer", "number", "boolean", "array", "object"]},
          "required": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1, "maxLength": 4000},
          "example": {},
          "default": {},
          "format": {"type": "string", "maxLength": 100},
          "enum_values": {"type": "array", "maxItems": 100}
        },
        "additionalProperties": false
      }
    },
    "body": {
      "type": "object",
      "required": ["content_type", "schema", "example"],
      "properties": {
        "content_type": {"const": "application/json"},
        "schema": {},
        "example": {}
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["status", "description", "content_type", "schema", "example"],
      "properties": {
        "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "content_type": {"const": "application/json"},
        "schema": {},
        "example": {}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["app_name"],
      "properties": {
        "app_id": {"type": "string", "maxLength": 200},
        "app_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "location": {"type": "string", "maxLength": 500},
        "note": {"type": "string", "maxLength": 4000}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
